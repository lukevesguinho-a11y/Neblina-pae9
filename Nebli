		fogToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

		Lighting.FogStart = 20
		Lighting.FogEnd = 300
		Lighting.FogColor = selectedColor
	else
		fogToggleBtn.Text = "Ativar Neblina: OFF"
		fogToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		fogToggleBtn.TextColor3 = Color3.fromRGB(255, 105, 180)

		Lighting.FogStart = originalFogStart
		Lighting.FogEnd = originalFogEnd
		Lighting.FogColor = originalFogColor
	end
end)

-- Sistema de Animação de Entrada e Saída
local isMenuOpen = true
local isAnimating = false

local function openMenu()
	if isAnimating or isMenuOpen then return end
	isAnimating = true
	isMenuOpen = true

	mainFrame.Visible = true
	toggleMenuBtn.Text = "Fechar Fog"
	uiScale.Scale = 0

	local tween = TweenService:Create(
		uiScale,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Scale = 1}
	)
	tween:Play()
	tween.Completed:Connect(function()
		isAnimating = false
	end)
end

local function closeMenu()
	if isAnimating or not isMenuOpen then return end
	isAnimating = true
	isMenuOpen = false

	toggleMenuBtn.Text = "Abrir Fog"

	local tween = TweenService:Create(
		uiScale,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{Scale = 0}
	)
	tween:Play()
	tween.Completed:Connect(function()
		if not isMenuOpen then
			mainFrame.Visible = false
		end
		isAnimating = false
	end)
end

toggleMenuBtn.MouseButton1Click:Connect(function()
	if isMenuOpen then
		closeMenu()
	else
		openMenu()
	end
end)

closeBtn.MouseButton1Click:Connect(closeMenu)
